    <sys:String x:Key="Lang.Set.ToolReady">工具集就绪 · DtsJobQueue 与 DTSEncConfig 已找到</sys:String>
    <sys:String x:Key="Lang.Set.ToolIncomplete">工具集不完整 · 请确认 DTS-HD_Tool 目录</sys:String>

    <!-- 自动检查更新 -->
    <sys:String x:Key="Lang.Settings.AutoCheckUpdate">启动时检查更新</sys:String>
    <sys:String x:Key="Lang.Update.FoundTitle">发现新版本</sys:String>
    <sys:String x:Key="Lang.Update.FoundBody">发现新版本 {0}（当前 {1}）。是否前往下载？</sys:String>
    <sys:String x:Key="Lang.Update.Later">稍后</sys:String>

    <!-- v1.1.0：音轨自动识别 / 鼠标悬浮提示 -->
    <sys:String x:Key="Lang.Encode.AutoDetectLayout">自动识别声道布局</sys:String>
    <sys:String x:Key="Lang.Settings.ShowToolTips">鼠标悬浮提示</sys:String>
    <sys:String x:Key="Lang.Log.LayoutAuto">已根据导入的声道自动切换布局：{0}</sys:String>
    <sys:String x:Key="Lang.Log.ChannelsRecognized">已识别 {0} 个声道：{1}</sys:String>
    <sys:String x:Key="Lang.Log.ChannelsMissing">仍有 {0} 个声道未导入：{1}</sys:String>
    <sys:String x:Key="Lang.Log.Dropped">拖入 {0} 个文件。</sys:String>
    <sys:String x:Key="Lang.Log.SwitchSingle">检测到多声道 WAV，已切换到单文件输入。</sys:String>
    <sys:String x:Key="Lang.Log.SwitchSplit">检测到分轨声道文件，已切换到分轨输入。</sys:String>
    <sys:String x:Key="Tip.ResetDefaults">将编码页的全部参数恢复为官方默认值</sys:String>
    <sys:String x:Key="Tip.LoadSettings">从已保存的设置档加载编码参数</sys:String>
    <sys:String x:Key="Tip.SaveSettings">把当前编码参数保存到设置档</sys:String>
    <sys:String x:Key="Tip.SaveSettingsAs">把当前编码参数另存为新的设置档文件</sys:String>
    <sys:String x:Key="Tip.SingleMode">输入一个多声道 WAV（最高 7.1）。程序按 dwChannelMask 自动把声道重排为 DTS 引擎期望的顺序</sys:String>
    <sys:String x:Key="Tip.SplitMode">每个声道一个单声道 WAV。导入任意一条音轨即可自动识别它属于哪个声道，并自动导入同目录同名的其它声道</sys:String>
    <sys:String x:Key="Tip.AutoDetectLayout">导入音轨时，根据文件名中的声道标记（L/FL/Left/左、Ls/SL、Lsr/BL、LFE/Sub/SW…）或 WAV 的声道掩码，自动切换到最匹配的声道布局</sys:String>
    <sys:String x:Key="Tip.Layout">编码使用的声道布局；开启「自动识别声道布局」后会随导入的音轨自动切换</sys:String>
    <sys:String x:Key="Tip.ClearAll">清除全部已导入的音轨</sys:String>
    <sys:String x:Key="Tip.SpeakerLayout">当前声道布局的扬声器位置示意</sys:String>
    <sys:String x:Key="Tip.SingleFile">多声道 WAV 文件路径，可直接把文件拖入此区域</sys:String>
    <sys:String x:Key="Tip.Browse">浏览并选择文件</sys:String>
    <sys:String x:Key="Tip.BrowseChannel">选择任一声道文件：自动识别声道并放入对应输入框，同时导入同组的其它声道</sys:String>
    <sys:String x:Key="Tip.BrowseSave">选择输出文件的保存位置</sys:String>
    <sys:String x:Key="Tip.BrowseFolder">浏览并选择文件夹</sys:String>
    <sys:String x:Key="Tip.ChannelAliases">可自动识别的文件名声道写法（不区分大小写）：</sys:String>
    <sys:String x:Key="Tip.ChannelFile">该声道的单声道 WAV。可拖入或点击「浏览…」；文件名形如 名称_L.wav、名称.FL.wav、名称-Left.wav、名称_左.wav 均可识别</sys:String>
    <sys:String x:Key="Tip.Output">编码输出文件路径（.dtshd / .cpt / .wav，取决于目标格式）</sys:String>
    <sys:String x:Key="Tip.DestFormat">目标载体格式：蓝光 / 蓝光副音频 / DVD / DTS 音乐盘 / 数字发行</sys:String>
    <sys:String x:Key="Tip.StreamType">码流类型，例如 DTS-HD Master Audio（无损）或 DTS-HD High Resolution</sys:String>
    <sys:String x:Key="Tip.EncodeType">编码类型</sys:String>
    <sys:String x:Key="Tip.SampleRate">采样率；导入 WAV 后自动与输入同步</sys:String>
    <sys:String x:Key="Tip.BitWidth">位宽（16 / 24 bit）；导入 WAV 后自动与输入同步</sys:String>
    <sys:String x:Key="Tip.CoreBitRate">DTS 核心（向下兼容层）的码率，单位 kbps</sys:String>
    <sys:String x:Key="Tip.DialNorm">对白归一化（Dialog Normalization）值</sys:String>
    <sys:String x:Key="Tip.Core9624">核心层使用 96/24 编码</sys:String>
    <sys:String x:Key="Tip.RearAtten">后置声道衰减 3 dB</sys:String>
    <sys:String x:Key="Tip.EsPhase">ES 后置声道相移</sys:String>
    <sys:String x:Key="Tip.EsPremixed">ES 预混：后中置已预先混入环绕声道</sys:String>
    <sys:String x:Key="Tip.FrameRate">时间码帧率</sys:String>
    <sys:String x:Key="Tip.Timecode">时间码，格式 HH:MM:SS:FF</sys:String>
    <sys:String x:Key="Tip.StartTime">起始时间码，格式 HH:MM:SS:FF</sys:String>
    <sys:String x:Key="Tip.EndTime">结束时间码（HH:MM:SS:FF）；导入音轨后按时长自动填写</sys:String>
    <sys:String x:Key="Tip.EncodeEntire">勾选后编码整个文件，忽略「编码自 / 编码至」</sys:String>
    <sys:String x:Key="Tip.EncodeFrom">从该时间码开始编码（HH:MM:SS:FF）</sys:String>
    <sys:String x:Key="Tip.EncodeTo">编码到该时间码为止（HH:MM:SS:FF）；导入音轨后自动填写</sys:String>
    <sys:String x:Key="Tip.RefTc">启用参考时间码</sys:String>
    <sys:String x:Key="Tip.PrimaryAtten">为主音频设置静态衰减与淡入淡出</sys:String>
    <sys:String x:Key="Tip.EmbedAaf">把 AAF 元数据嵌入码流</sys:String>
    <sys:String x:Key="Tip.AafFile">AAF 元数据文件路径</sys:String>
    <sys:String x:Key="Tip.Panning">启用 AAF 声像（Panning）值</sys:String>
    <sys:String x:Key="Tip.SingleClip">无缝分支：单一剪辑</sys:String>
    <sys:String x:Key="Tip.CsvBranch">无缝分支：使用 CSV 文件中的分支点</sys:String>
    <sys:String x:Key="Tip.CsvFile">CSV 分支点文件路径</sys:String>
    <sys:String x:Key="Tip.ExpressDialog">DTS Express 对话模式</sys:String>
    <sys:String x:Key="Tip.WideRemap">7.1 Wide 声道重映射</sys:String>
    <sys:String x:Key="Tip.ProgramInfo">写入码流的节目信息（可选）</sys:String>
    <sys:String x:Key="Tip.Downmix51">启用 6.1/7.1 → 5.1 下混矩阵（6.x/7.x 布局必须启用）</sys:String>
    <sys:String x:Key="Tip.KeepCurrent">保留当前（primary）声道</sys:String>
    <sys:String x:Key="Tip.LegacyMatrix">使用旧版（Legacy）下混矩阵</sys:String>
    <sys:String x:Key="Tip.Downmix20">启用 → 2.0 立体声下混</sys:String>
    <sys:String x:Key="Tip.LoRo">Lo/Ro：普通立体声下混</sys:String>
    <sys:String x:Key="Tip.LtRt">Lt/Rt：矩阵环绕兼容的立体声下混</sys:String>
    <sys:String x:Key="Tip.Saturation">下混饱和（削波）检测</sys:String>
    <sys:String x:Key="Tip.EmbeddedDownmix">把下混系数嵌入码流</sys:String>
    <sys:String x:Key="Tip.Start">写出 .cfg 并提交 DtsJobQueue 引擎开始编码</sys:String>
    <sys:String x:Key="Tip.Stop">终止当前编码任务</sys:String>
    <sys:String x:Key="Tip.OpenQueue">打开编码队列窗口查看各任务进度（关闭窗口不影响编码）</sys:String>
    <sys:String x:Key="Tip.PreviewCfg">预览将要写出的 .cfg 配置内容</sys:String>
    <sys:String x:Key="Tip.PreviewCmd">预览将发送给引擎的命令</sys:String>
    <sys:String x:Key="Tip.ViewLog">查看操作与编码日志（含声道识别结果）</sys:String>
    <sys:String x:Key="Tip.SilenceLen">静音时长（时间码 HH:MM:SS:FF）</sys:String>
    <sys:String x:Key="Tip.RemoveRow">移除这一行</sys:String>
    <sys:String x:Key="Tip.AddRow">添加一个待合并的文件行</sys:String>
    <sys:String x:Key="Tip.MetaDialNorm">新的对白归一化值（dBFS）</sys:String>
    <sys:String x:Key="Tip.RawSend">把上面的 T 命令直接发送给 DTSToolFramewrk 引擎</sys:String>
    <sys:String x:Key="Tip.CancelOp">取消正在执行的 StreamTools 操作</sys:String>
    <sys:String x:Key="Tip.ToolDir">DTS-HD_Tool 目录（包含 DtsJobQueue.exe、DTSEncConfig.dll 等官方工具）</sys:String>
    <sys:String x:Key="Tip.AutoDetect">自动查找 DTS-HD_Tool 目录</sys:String>
    <sys:String x:Key="Tip.OpenDir">在文件资源管理器中打开该目录</sys:String>
    <sys:String x:Key="Tip.SaveReconnect">保存目录设置并重新连接编码引擎</sys:String>
    <sys:String x:Key="Tip.Mica">Windows 11 云母背景效果</sys:String>
    <sys:String x:Key="Tip.Theme">切换跟随系统 / 浅色 / 深色主题</sys:String>
    <sys:String x:Key="Tip.Language">切换界面语言，实时生效</sys:String>
    <sys:String x:Key="Tip.ShowToolTips">开启后，鼠标停留在按钮、输入框等控件上时显示说明</sys:String>
    <sys:String x:Key="Tip.CheckUpdate">查询 GitHub 上的最新发布版本</sys:String>
    <sys:String x:Key="Tip.OpenDownload">在浏览器中打开新版本下载页</sys:String>
    <sys:String x:Key="Tip.AutoCheckUpdate">启动时自动检查新版本，仅在发现更新时提示</sys:String>
</ResourceDictionary>
