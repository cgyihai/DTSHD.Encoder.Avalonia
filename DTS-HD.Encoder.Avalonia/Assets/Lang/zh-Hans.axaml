    <!-- VM 动态状态文案 -->
    <sys:String x:Key="Lang.Theme.System">跟随系统</sys:String>
    <sys:String x:Key="Lang.Theme.Light">浅色</sys:String>
    <sys:String x:Key="Lang.Theme.Dark">深色</sys:String>
    <sys:String x:Key="Lang.Eng.Connecting">正在连接引擎…</sys:String>
    <sys:String x:Key="Lang.Eng.NotReady">工具集未就绪 · 请到「设置」配置 DTS-HD_Tool 目录</sys:String>
    <sys:String x:Key="Lang.Eng.Connected">引擎已连接 · {0}</sys:String>
    <sys:String x:Key="Lang.St.EngNotReady">工具集未就绪 · 请到「设置」配置 DTS-HD_Tool（需 DTSToolFramewrk.exe）</sys:String>
    <sys:String x:Key="Lang.St.EngConnected">StreamTools 引擎已连接</sys:String>
    <sys:String x:Key="Lang.St.EngIdle">工具集就绪 · StreamTools（操作时自动连接）</sys:String>
