    <sys:String x:Key="Tip.CancelOp">Cancel the running StreamTools operation</sys:String>
    <sys:String x:Key="Tip.ToolDir">DTS-HD_Tool folder (contains DtsJobQueue.exe, DTSEncConfig.dll and the other official tools)</sys:String>
    <sys:String x:Key="Tip.AutoDetect">Locate the DTS-HD_Tool folder automatically</sys:String>
    <sys:String x:Key="Tip.OpenDir">Open the folder in File Explorer</sys:String>
