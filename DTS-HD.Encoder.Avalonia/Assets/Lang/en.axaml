    <sys:String x:Key="Tip.StartTime">Start timecode, format HH:MM:SS:FF</sys:String>
    <sys:String x:Key="Tip.EndTime">End timecode (HH:MM:SS:FF); filled automatically from the track duration</sys:String>
    <sys:String x:Key="Tip.EncodeEntire">Encode the whole file and ignore “Encode from / to”</sys:String>
