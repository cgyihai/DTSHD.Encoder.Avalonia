    <!-- v1.1.0：音轨自动识别 / 鼠标悬浮提示 -->
    <sys:String x:Key="Lang.Encode.AutoDetectLayout">Auto-detect channel layout</sys:String>
    <sys:String x:Key="Lang.Settings.ShowToolTips">Hover tooltips</sys:String>
    <sys:String x:Key="Lang.Log.LayoutAuto">Channel layout switched automatically from the imported tracks: {0}</sys:String>
